Self>`.\n"},"level":"error","spans":[{"file_name":"src/domain/speculative_engine.rs","byte_start":7841,"byte_end":7886,"line_start":183,"line_end":183,"column_start":13,"column_end":58,"is_primary":true,"text":[{"text":"            signer.precompute_nonces(&message_for_nonces).await","highlight_start":13,"highlight_end":58}],"label":"`SignerPort` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/ports/mod.rs","byte_start":755,"byte_end":765,"line_start":19,"line_end":19,"column_start":11,"column_end":21,"is_primary":false,"text":[{"text":"pub trait SignerPort: Send + Sync {","highlight_start":11,"highlight_end":21}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/ports/mod.rs","byte_start":927,"byte_end":944,"line_start":22,"line_end":22,"column_start":14,"column_end":31,"is_primary":true,"text":[{"text":"    async fn precompute_nonces(&self, message: &[u8]) -> Result<Vec<u8>, EnclaveError>;","highlight_start":14,"highlight_end":31}],"label":"...because method `precompute_nonces` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/ports/mod.rs","byte_start":1127,"byte_end":1145,"line_start":26,"line_end":26,"column_start":14,"column_end":32,"is_primary":true,"text":[{"text":"    async fn finalize_signature(","highlight_start":14,"highlight_end":32}],"label":"...because method `finalize_signature` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[],"rendered":null},{"message":"consider moving `precompute_nonces` to another trait","code":null,"level":"help","spans":[]