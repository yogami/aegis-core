m `Super<Self>`.\n"},"level":"error","spans":[{"file_name":"src/domain/speculative_engine.rs","byte_start":7315,"byte_end":7337,"line_start":170,"line_end":170,"column_start":25,"column_end":47,"is_primary":true,"text":[{"text":"        let evaluator = self.evaluator.clone();","highlight_start":25,"highlight_end":47}],"label":"`PolicyEvaluatorPort` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/ports/mod.rs","byte_start":371,"byte_end":390,"line_start":10,"line_end":10,"column_start":11,"column_end":30,"is_primary":false,"text":[{"text":"pub trait PolicyEvaluatorPort: Send + Sync {","highlight_start":11,"highlight_end":30}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/ports/mod.rs","byte_start":549,"byte_end":557,"line_start":13,"line_end":13,"column_start":14,"column_end":22,"is_primary":true,"text":[{"text":"    async fn evaluate(&self, intent: &TransactionIntent) -> Result<PolicyVerdict, EnclaveError>;","highlight_start":14,"highlight_end":22}],"label":"...because method `evaluate` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[],"rendered":null},{"message":"consider moving `evaluate` to another trait","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"only type `infrastructure::slm_client::SLMClient` implements `PolicyEvaluatorPort`; consider using it directly instead.","code":null,"level":"help","spans":[],"children":[],"rendered":null}],"rendered":"\u001b[1m\u001b[91merror[E0038]\u001b[0m\u001b[1m: the trait `PolicyEvaluatorPort` is not dyn compatible\u001b[0m\n   \u001b[1m\u00