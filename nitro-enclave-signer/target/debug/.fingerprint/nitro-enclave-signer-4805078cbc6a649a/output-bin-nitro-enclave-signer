m `Super<Self>`.\n"},"level":"error","spans":[{"file_name":"src/domain/speculative_engine.rs","byte_start":1507,"byte_end":1530,"line_start":42,"line_end":42,"column_start":24,"column_end":47,"is_primary":true,"text":[{"text":"        evaluator: Arc<dyn PolicyEvaluatorPort>,","highlight_start":24,"highlight_end":47}],"label":"`PolicyEvaluatorPort` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/ports/mod.rs","byte_start":371,"byte_end":390,"line_start":10,"line_end":10,"column_start":11,"column_end":30,"is_primary":false,"text":[{"text":"pub trait PolicyEvaluatorPort: Send + Sync {","highlight_start":11,"highlight_end":30}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/ports/mod.rs","byte_start":549,"byte_end":557,"line_start":13,"line_end":13,"column_start":14,"column_end":22,"is_primary":true,"text":[{"text":"    async fn evaluate(&self, intent: &TransactionIntent) -> Result<PolicyVerdict, EnclaveError>;","highlight_start":14,"highlight_end":22}],"label":"...because method `evaluate` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[],"rendered":null},{"message":"consider moving `evaluate` to another trait","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"only type `infrastructure::slm_client::SLMClient` implements `PolicyEvaluatorPort`; consider using it directly instead.","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"you might have meant to use `Self` to refer to the implementing type","code":null,"level":"help","spans":[{"file_name":"src/domain/sp